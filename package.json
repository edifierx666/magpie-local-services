{
  "name": "magpie-local-services",
  "version": "0.2.1",
  "description": "Local services for magpie: run, supervise and update long-running local commands, and share local ports via Cloudflare quick tunnels",
  "homepage": "https://github.com/edifierx666/magpie-local-services#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edifierx666/magpie-local-services.git"
  },
  "bugs": {
    "url": "https://github.com/edifierx666/magpie-local-services/issues"
  },
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "lib",
    "page",
    "web",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "services",
    "cloudflare-tunnel"
  ],
  "license": "MIT",
  "scripts": {
    "test": "bun test"
  },
