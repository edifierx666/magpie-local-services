    "summary": {
      "en": "Run, supervise and update long-running local commands.",
      "zh": "运行、守护和更新长期运行的本地命令。"
    },
    "page": {
      "title": "Local Services",
      "titles": {
        "zh": "本地服务",
        "zh-TW": "本機服務"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3427,
        "option": "port"
      }
    },
    "permissions": [],
    "options": {
      "port": 3427
    }
  }
}
